{
  "name": "@frontier-fi/frontend",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "start": "turbo start",
    "dev": "turbo dev",
    "dev:fork": "NEXT_PUBLIC_E2E_DEV=1 pnpm dev",
    "graphql:gen": "turbo graphql:gen",
    "lint:all": "turbo run lint format --continue",
    "lint:all:fix": "turbo run lint:fix format:fix --continue --force",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "prettier": "turbo prettier",
    "prettier:fix": "turbo prettier:fix",
    "stylelint": "turbo stylelint",
    "stylelint:fix": "turbo stylelint:fix",
    "test": "pnpm i --frozen-lockfile && pnpm lint && pnpm prettier && pnpm stylelint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:e2e:build",
    "test:uncached": "pnpm i --frozen-lockfile && pnpm test:clean-caches && turbo lint --force && turbo prettier --force && turbo stylelint --force && turbo typecheck --force && turbo test:unit --force --ui=stream --log-order=stream && turbo test:integration --force --ui=stream --log-order=stream && turbo test:e2e:build --force --ui=stream --log-order=stream && pnpm test:docker --no-cache",
    "test:clean-caches": "rm -rf .eslintcache apps/*/.eslintcache packages/*/.eslintcache node_modules/.cache apps/*/node_modules/.cache packages/*/node_modules/.cache *.tsbuildinfo apps/*/*.tsbuildinfo packages/*/*.tsbuildinfo",
    "test:docker": "bash scripts/test-docker.sh",
    "test:e2e:build": "turbo test:e2e:build --ui=stream --log-order=stream --",
    "test:e2e:build:ui": "turbo test:e2e:build:ui --ui=stream --log-order=stream --",
    "test:e2e:dev": "NEXT_PUBLIC_E2E_DEV=1 turbo test:e2e:dev --ui=stream --log-order=stream --",
    "test:e2e:dev:ui": "NEXT_PUBLIC_E2E_DEV=1 turbo test:e2e:dev:ui --ui=stream --log-order=stream --",
    "test:integration": "turbo test:integration --ui=stream --log-order=stream --",
    "test:integration:watch": "turbo test:integration:watch --ui=stream --log-order=stream --",
    "test:unit": "turbo test:unit --ui=stream --log-order=stream --",
    "test:unit:watch": "turbo test:unit:watch --ui=stream --log-order=stream --",
    "test:save-api-mocks": "turbo test:save-api-mocks --ui=stream --log-order=stream --",
    "typecheck": "turbo typecheck",
    "prepare": "husky",
    "sync:playwright": "node packages/e2e-tests/scripts/sync-playwright-image.mjs",
    "sync:playwright:check": "node packages/e2e-tests/scripts/sync-playwright-image.mjs --check",
    "playwright:install": "pnpm --filter=e2e-tests playwright:install",
    "playwright:install:chromium": "pnpm --filter=e2e-tests playwright:install:chromium"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "stylelint-prettier": "5.0.3",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "vitest-mock-extended": "5.1.1"
  },
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=8"
  }
}
