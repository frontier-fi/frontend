{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_APP_ENV",
    "NEXT_PUBLIC_PROJECT_ID",
    "DRPC_API_KEY",
    "HYPERNATIVE_API_ID",
    "HYPERNATIVE_API_SECRET",
    "NEXT_PUBLIC_WALLET_CONNECT_ID",
    "CURRENCYAPI_KEY",
    "VITEST_POOL_ID",
    "NODE_ENV",
    "SILENT_TESTS",
    "NEXT_RUNTIME",
    "NEXT_PHASE",
    "NEXT_PUBLIC_E2E_DEV",
    "CI",
    "ALLOWED_ORIGINS",
    "TZ",
    "TEST_ACCOUNT_MNEMONIC"
  ],
  "globalPassThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^start"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["^transit"],
      "outputs": [
        "node_modules/.cache/.eslintcache",
        ".next/cache/eslint",
        ".eslintcache"
      ]
    },
    "lint:fix": {
      "dependsOn": ["^transit"],
      "outputs": ["node_modules/.cache/.eslintcache", ".next/cache/eslint"]
    },
    "typecheck": {
      "dependsOn": ["^graphql:gen", "^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/lib/global.d.ts",
        "shared/services/api/generated/**"
      ],
      "outputs": ["node_modules/.cache/tsbuildinfo.json"]
    },
    "test:unit": {
      "dependsOn": ["^graphql:gen", "^test:unit"]
    },
    "test:unit:watch": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^graphql:gen"]
    },
    "test:integration": {
      "dependsOn": ["^graphql:gen", "^test:integration"]
    },
    "test:integration:watch": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^graphql:gen"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "test:save-api-mocks": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^graphql:gen"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "test:e2e:build": {
      "dependsOn": ["frontend-v3#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "test:e2e:build:ui": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^transit"]
    },
    "test:e2e:dev": {
      "dependsOn": ["frontend-v3#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "NEXT_E2E_DEV"],
      "env": ["E2E_SHARD"]
    },
    "test:e2e:dev:ui": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^transit"]
    },
    "graphql:gen": {
      "dependsOn": ["^graphql:gen"],
      "inputs": ["**/*.graphql"],
      "outputs": ["shared/services/api/generated/**"]
    },
    "prettier": {
      "dependsOn": ["^prettier"],
      "outputs": [".prettiercache"]
    },
    "prettier:fix": {
      "dependsOn": ["^prettier:fix"],
      "outputs": [".prettiercache"],
      "cache": false
    },
    "stylelint": {
      "dependsOn": ["^stylelint"]
    },
    "stylelint:fix": {
      "dependsOn": ["^stylelint:fix"],
      "cache": false
    }
  },
  "remoteCache": {
    "enabled": true
  }
}
