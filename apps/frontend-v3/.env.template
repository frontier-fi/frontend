NEXT_PUBLIC_APP_ENV=dev
NEXT_PUBLIC_API_URL=https://api.frontier.fi/graphql

# For WalletConnect modal (optional in dev, required in prod)
NEXT_PUBLIC_WALLET_CONNECT_ID=

# For wallet checks (optional)
HYPERNATIVE_API_ID=
HYPERNATIVE_API_SECRET=

# For fiat currency conversions (optional; disabled in dev)
CURRENCYAPI_KEY=

# For integration tests and rpc proxy routes (optional)
DRPC_API_KEY=

# To allow specific origins for api/rpc proxy routes
ALLOWED_ORIGINS='http://localhost:3000'

# Uncomment to run manual impersonations with anvil form
# NEXT_PUBLIC_E2E_DEV=1 # Run in fork mode